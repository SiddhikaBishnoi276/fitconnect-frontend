{
  "name": "fitconnect",
  "displayName": "FitConnect",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --no-packager --appIdSuffix debug",
    "android:device": "react-native run-android --no-packager --device --appIdSuffix debug",
    "android:release": "react-native run-android --no-packager --mode=release",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "apk:standalone": "npm run bundle:android && cd android && ./gradlew assembleDebug",
    "reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:5000 tcp:5000",
    "clean:android": "cd android && ./gradlew clean",
    "clean:metro": "react-native start --reset-cache",
    "prepare": "husky"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.3.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "^7.3.21",
    "@react-navigation/drawer": "^7.3.21",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.10.0",
    "date-fns": "^4.1.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-bootsplash": "^6.3.5",
    "react-native-config": "^1.5.5",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^3.3.0",
    "react-native-permissions": "^5.5.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.10.0",
    "react-native-svg": "^15.12.0",
    "react-native-toast-message": "^2.3.2",
    "react-native-vector-icons": "^10.2.0",
    "react-native-worklets": "^0.12.2",
    "react-native-worklets-core": "^1.6.3",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "@types/redux-persist": "^4.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "19.2.3",
    "typescript": "5.0.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFilesAfterFramework": [],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-reanimated|react-native-gesture-handler|react-native-vector-icons|react-native-mmkv|react-native-config|react-native-screens|react-native-safe-area-context|react-native-fast-image|react-native-bootsplash|react-native-toast-message|react-native-svg|react-native-permissions|react-native-keychain|redux-persist)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@api/(.*)$": "<rootDir>/src/api/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@constants/(.*)$": "<rootDir>/src/constants/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@navigation/(.*)$": "<rootDir>/src/navigation/$1",
      "^@screens/(.*)$": "<rootDir>/src/screens/$1",
      "^@store/(.*)$": "<rootDir>/src/store/$1",
      "^@theme/(.*)$": "<rootDir>/src/theme/$1",
      "^@t/(.*)$": "<rootDir>/src/types/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1"
    }
  },
  "engines": {
    "node": ">= 18.0.0"
  }
}
